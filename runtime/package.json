{
  "name": "@aies/core",
  "version": "0.2.0",
  "private": true,
  "description": "AIES como extensión de Pi (ADR-010): bucle de orquestación + workers efímeros; InteractiveMode provee la TUI.",
  "type": "module",
  "main": "src/extension/index.ts",
  "bin": {
    "aies": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/extension/index.ts",
    "./prompts": "./src/extension/prompts.ts",
    "./types": "./src/extension/types.ts"
  },
  "files": [
    "dist",
    "aies.config.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "build:tests": "tsc -p tsconfig.test.json",
    "typecheck": "tsc --noEmit; tsc -p tsconfig.test.json --noEmit",
    "start": "tsx src/cli.ts",
    "test:loop": "tsc -p tsconfig.test.json && node dist-test/tests/loop.test.js",
    "test:unitid": "tsc -p tsconfig.test.json && node dist-test/tests/unitid.test.js",
    "test:cost": "tsc -p tsconfig.test.json && node dist-test/tests/cost.test.js",
    "test:parse": "tsc -p tsconfig.test.json && node dist-test/tests/parse.test.js",
    "test:e2e": "vitest run tests/smoke-e2e.test.ts",
    "test:persist": "node dist/self-check/persistence.js",
    "test:orch": "node dist/self-check/orchestrator.js",
    "test:compaction": "node dist/self-check/compaction.js",
    "test:workers": "node dist/self-check/workers.js",
    "test:extension": "node dist/self-check/extension.js",
    "test": "pnpm test:parse && pnpm test:unitid && pnpm test:loop && pnpm test:cost && pnpm test:e2e",
    "research:metrics": "node dist/research/metrics.js",
    "research:baseline": "node dist/research/baseline.js",
    "pi:dev": "pi -e ./src/extension/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "~0.84.2",
    "picocolors": "^1.1.1",
    "typebox": "1.3.7",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
