---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { inject } from '@vercel/analytics';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AIES — El Harness y Runtime para Agentes de IA",
  description = "AIES organiza el trabajo de agentes de IA con descomposición adaptativa de tareas, aislamiento estricto de contexto y verificación continua.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts: Geist & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Theme initialization script (prevents FOUC) -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem('theme');
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (storedTheme === 'dark' || (!storedTheme && systemDark)) {
          document.documentElement.classList.add('dark');
        } else if (storedTheme === 'light') {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <Analytics />
    <script>
      inject();
    </script>
  </head>

  <body class="bg-[var(--color-bg)] text-[var(--color-text)] transition-colors duration-200 relative min-h-screen flex flex-col justify-between">
    <!-- Progressive Blur Sticky Header -->
    <header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-[var(--color-bg)]/80 border-b border-[var(--color-border)] transition-colors duration-200">
      <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group">
          <span class="font-semibold text-sm tracking-tight text-[var(--color-text)]">
            AIES
          </span>
          <span class="text-[11px] font-mono text-[var(--color-text-muted)] bg-[var(--color-surface-2)] px-1.5 py-0.5 rounded border border-[var(--color-border)]">
            v0.3.0
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm text-[var(--color-text-muted)] font-normal">
          <a href="/#problema" class="nav-underline hover:text-[var(--color-text)] transition-colors">Problema</a>
          <a href="/#arquitectura" class="nav-underline hover:text-[var(--color-text)] transition-colors">Arquitectura</a>
          <a href="/#quickstart" class="nav-underline hover:text-[var(--color-text)] transition-colors">Instalación</a>
          <a href="/roadmap" class="hover:text-[var(--color-text)] text-[var(--color-text)] font-medium transition-colors">
            Hoja de ruta
          </a>
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="/#apoyo"
            title="Apoyar el desarrollo de AIES"
            class="hidden sm:flex px-3 py-1.5 rounded-md text-xs font-medium border border-amber-500/30 bg-amber-500/10 text-amber-600 dark:text-amber-400 hover:bg-amber-500/20 hover:border-amber-500/50 transition-all items-center gap-1.5"
          >
            <span>☕ Apoyar</span>
          </a>

          <a
            href="https://github.com/EzequielMenor/AIES"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-arrow px-3 py-1.5 rounded-md text-xs font-medium border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] hover:bg-[var(--color-surface-2)] hover:border-[var(--color-border-hover)] transition-all"
          >
            <span>GitHub</span>
            <span class="text-[11px] text-[var(--color-text-muted)]">&nearr;</span>
          </a>

          <!-- Theme Toggle -->
          <button
            id="theme-toggle"
            aria-label="Cambiar tema"
            class="p-1.5 rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-border-hover)] transition-colors cursor-pointer"
          >
            <svg id="theme-icon-sun" class="icon-rotate w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
            <svg id="theme-icon-moon" class="icon-rotate w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <div id="top" class="relative z-10 hero-glow hero-parallax grow">
      <slot />
    </div>

    <!-- Minimalist Footer -->
    <footer class="border-t border-[var(--color-border)] py-16 px-6 transition-colors duration-200 mt-28">
      <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between text-xs text-[var(--color-text-muted)] gap-6">
        <div class="space-y-1 text-center sm:text-left">
          <p class="text-[var(--color-text)] font-medium">AIES &mdash; Autonomous Software Engineering Harness & Runtime</p>
          <p class="opacity-75">MIT License &bull; Desarrollado por <a href="https://ezequielmenor.es" target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--color-text)]">Ezequiel Menor</a></p>
        </div>

        <div class="flex items-center gap-6 font-mono text-xs">
          <a href="/roadmap" class="hover:text-[var(--color-text)] transition-colors">
            Hoja de ruta
          </a>
          <a href="https://github.com/EzequielMenor/AIES/blob/main/01-Concept/Principles.md" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text)] transition-colors">
            20 Principios
          </a>
          <a href="https://github.com/EzequielMenor/AIES/tree/main/05-Decisions" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-text)] transition-colors">
            ADRs
          </a>
          <a href="https://buymeacoffee.com/wm2jv22vfmx" target="_blank" rel="noopener noreferrer" class="btn-arrow hover:text-[var(--color-text)] transition-colors">
            <span>Buy Me a Coffee</span>
            <span>&nearr;</span>
          </a>
          <a href="https://ko-fi.com/ezequiel_33" target="_blank" rel="noopener noreferrer" class="btn-arrow hover:text-[var(--color-text)] transition-colors">
            <span>Ko-fi</span>
            <span>&nearr;</span>
          </a>
          <a href="https://github.com/Ezequielmenor/AIES" target="_blank" rel="noopener noreferrer" class="btn-arrow hover:text-[var(--color-text)] transition-colors">
            <span>GitHub</span>
            <span>&nearr;</span>
          </a>
        </div>
      </div>
    </footer>

    <!-- Global Client Scripts -->
    <script>
      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      // Mark body as loaded on next frame so initial hero animation can play
      requestAnimationFrame(() => {
        document.body.classList.add('is-loaded');
      });

      // Theme toggle: flip .dark, persist, rotate icons 180° each click
      const themeToggle = document.getElementById('theme-toggle');
      const sunIcon = document.getElementById('theme-icon-sun');
      const moonIcon = document.getElementById('theme-icon-moon');
      let iconRot = 0;
      const rotateIcons = () => {
        iconRot += 180;
        if (sunIcon) sunIcon.style.setProperty('--icon-rot', `${iconRot}deg`);
        if (moonIcon) moonIcon.style.setProperty('--icon-rot', `${iconRot}deg`);
      };
      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
          rotateIcons();
        });
      }

      // Reveal observer: handles both .animate-on-scroll and .reveal-stagger
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target;
            if (el.hasAttribute('data-stagger')) {
              el.classList.add('is-visible');
            } else {
              el.classList.add('visible');
            }
            revealObserver.unobserve(el);
          });
        },
        { threshold: 0.04 }
      );

      document.querySelectorAll('[data-animate="true"]').forEach((el) => {
        if (el.hasAttribute('data-stagger')) {
          el.classList.add('reveal-stagger');
        } else {
          el.classList.add('animate-on-scroll');
        }
        revealObserver.observe(el);
      });

      // Hairline draw observer
      const hairlineObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in-view');
              hairlineObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.5 }
      );
      document.querySelectorAll('.hairline-draw, .hairline-rule').forEach((el) => {
        hairlineObserver.observe(el);
      });

      // Hero parallax on #top — only when motion is allowed
      if (!prefersReducedMotion) {
        const hero = document.getElementById('top');
        if (hero) {
          let rafId = 0;
          let targetX = 0;
          let targetY = 0;
          const onMove = (e) => {
            const rect = hero.getBoundingClientRect();
            const nx = (e.clientX - rect.left) / rect.width - 0.5;
            const ny = (e.clientY - rect.top) / rect.height - 0.5;
            targetX = nx * 8;
            targetY = ny * 6;
            if (!rafId) {
              rafId = requestAnimationFrame(() => {
                hero.style.setProperty('--parallax-x', `${targetX.toFixed(2)}px`);
                hero.style.setProperty('--parallax-y', `${targetY.toFixed(2)}px`);
                rafId = 0;
              });
            }
          };
          const onLeave = () => {
            targetX = 0;
            targetY = 0;
            hero.style.setProperty('--parallax-x', '0px');
            hero.style.setProperty('--parallax-y', '0px');
          };
          hero.addEventListener('mousemove', onMove);
          hero.addEventListener('mouseleave', onLeave);
        }
      }
    </script>
  </body>
</html>
